SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Al conectar el dominio propio, agregarlo a ALLOWED_HOSTS y su
# origen HTTPS a CSRF_TRUSTED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=https://crm.dominio-de-isyn.com
# En Render, definir DATABASE_URL con la URI de PostgreSQL del servicio de producción.
# En local, si no se define, se usa SQLite.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Búsqueda de compradores con IA (Gemini + Google Search). Se saca en
# https://aistudio.google.com/apikey — requiere prepago activado en el
# proyecto para poder usar la búsqueda con web (ver DESIGN.md / conversación
# de configuración). Si se deja vacío, la función se muestra deshabilitada.
GEMINI_API_KEY=
# Tope duro de búsquedas por día, para nunca acercarse a un gasto inesperado.
BUSQUEDA_IA_LIMITE_DIARIO=20

# Correo saliente. Los envíos masivos y las alertas automáticas permanecen
# deshabilitados hasta configurar host y credenciales SMTP corporativas.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@isyn.com
